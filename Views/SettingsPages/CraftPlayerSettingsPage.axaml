<ci:SettingsPageBase x:Class="CraftPlayer.Views.SettingsPages.CraftPlayerSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="280,*" ColumnSpacing="12" RowSpacing="12">
        <StackPanel Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="8">
            <ToggleSwitch IsChecked="{Binding EnableSmtc, Mode=TwoWay}" />
            <TextBlock VerticalAlignment="Center"
                       Text="启用 SMTC（系统媒体传输控制）" />
        </StackPanel>

        <Border Grid.Row="1"
                Grid.Column="0"
                Padding="8"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="*,Auto,Auto"
                  RowSpacing="8">
                <ListBox x:Name="PlaylistListBox"
                         ItemsSource="{Binding Playlists}"
                         SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBox x:Name="PlaylistNameTextBox"
                         Grid.Row="1"
                         IsEnabled="{Binding CanModifySelectedPlaylist}"
                         Watermark="输入歌单名称" />
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="6">
                    <Button Content="新增"
                            Click="AddPlaylistButton_OnClick" />
                    <Button Content="重命名"
                            IsEnabled="{Binding CanModifySelectedPlaylist}"
                            Click="RenamePlaylistButton_OnClick" />
                    <Button Content="删除"
                            IsEnabled="{Binding CanModifySelectedPlaylist}"
                            Click="DeletePlaylistButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Padding="8"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="8">
                <WrapPanel Orientation="Horizontal"
                           ItemHeight="32"
                           ItemSpacing="6">
                    <Button Content="导入音频"
                            IsEnabled="{Binding CanModifySelectedPlaylist}"
                            Click="ImportButton_OnClick" />
                    <Button Content="删除曲目"
                            IsEnabled="{Binding CanModifySelectedPlaylist}"
                            Click="DeleteTrackButton_OnClick" />
                    <Button Content="清除已播放状态"
                            IsEnabled="{Binding CanModifySelectedPlaylist}"
                            Click="ClearPlayedStateButton_OnClick" />
                    <Button Content="全选"
                            IsEnabled="{Binding CanModifySelectedPlaylist}"
                            Click="CheckAllTracksButton_OnClick" />
                    <Button Content="取消勾选"
                            IsEnabled="{Binding CanModifySelectedPlaylist}"
                            Click="ClearCheckedTracksButton_OnClick" />
                    <Button Content="上移"
                            IsEnabled="{Binding CanModifySelectedPlaylist}"
                            Click="MoveUpButton_OnClick" />
                    <Button Content="下移"
                            IsEnabled="{Binding CanModifySelectedPlaylist}"
                            Click="MoveDownButton_OnClick" />
                    <Button Content="一键打乱"
                            IsEnabled="{Binding CanModifySelectedPlaylist}"
                            Click="ShuffleButton_OnClick" />
                    <Button Content="导出CSV"
                            Click="ExportCsvButton_OnClick" />
                </WrapPanel>
                <dg:DataGrid x:Name="TrackDataGrid"
                             Grid.Row="1"
                             AutoGenerateColumns="False"
                             CanUserSortColumns="False"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="False"
                             FocusAdorner="{x:Null}"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             ItemsSource="{Binding Tracks}"
                             MaxColumnWidth="320"
                             MinColumnWidth="80"
                             SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                             SizeChanged="TrackDataGrid_OnSizeChanged">
                    <dg:DataGrid.Styles>
                        <Style Selector="dg|DataGridCell">
                            <Setter Property="FocusAdorner" Value="{x:Null}" />
                        </Style>
                        <Style Selector="dg|DataGridRow">
                            <Setter Property="FocusAdorner" Value="{x:Null}" />
                        </Style>
                    </dg:DataGrid.Styles>
                    <dg:DataGrid.Columns>
                        <dg:DataGridTemplateColumn Header="勾选"
                                                   Width="52"
                                                   MinWidth="52"
                                                   MaxWidth="52"
                                                   CanUserResize="False">
                            <dg:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>
                        <dg:DataGridTemplateColumn Header="标题"
                                                   Width="Auto"
                                                   IsReadOnly="True">
                            <dg:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>
                        <dg:DataGridTemplateColumn Header="歌手"
                                                   Width="Auto"
                                                   IsReadOnly="True">
                            <dg:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding Artist}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>
                        <dg:DataGridTemplateColumn Header="时长"
                                                   Width="Auto"
                                                   IsReadOnly="True">
                            <dg:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding Duration}" />
                                </DataTemplate>
                            </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>
                        <dg:DataGridTemplateColumn Header="文件名"
                                                   Width="Auto"
                                                   IsReadOnly="True">
                            <dg:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>
                        <dg:DataGridTemplateColumn Header="播放状态"
                                                   Width="Auto"
                                                   IsReadOnly="True">
                            <dg:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center"
                                               Opacity="0.75"
                                               Text="{Binding PlayStateText}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>
                    </dg:DataGrid.Columns>
                </dg:DataGrid>
            </Grid>
        </Border>
    </Grid>
</ci:SettingsPageBase>
